# ════════════════════════════════════════════════════════════════
#  RyzeBooth — environment variables
# ════════════════════════════════════════════════════════════════
#  Local:   copy this file to `.env` and run `vercel dev`.
#  Live:    Vercel → Project → Settings → Environment Variables.
#           (You can paste this whole file into the first box and
#           Vercel splits it into separate variables.)
#  Vercel does NOT read a committed .env in production, and `.env`
#  is git-ignored on purpose — never commit real values.
#  After changing a variable on Vercel, redeploy for it to apply.
# ════════════════════════════════════════════════════════════════


# ── Required ────────────────────────────────────────────────────

# Passcode for developer / admin mode (api/admin.js). Unset = nobody can sign in.
ADMIN_PASS=

# Where finished strips are posted (api/discord.js). Unset = strips just aren't sent.
DISCORD_WEBHOOK=

# Database for shared strips, shared colours, saved photos and admin settings.
# Vercel → Storage → Marketplace → "Upstash for Redis" → connect to this project
# and these are filled in for you. Either naming works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=


# ── Links and public settings (safe to be public) ───────────────
# Served to the page by api/public-config.mjs, so no link is ever
# written into app.js or index.html. Leave blank to hide that icon.

APP_NAME=RyzeBooth
DISCORD_INVITE_URL=
GITHUB_URL=

# Your own PeerJS signalling server (see peer-server/). Leave PEER_HOST blank
# to keep using the free public PeerJS broker.
# If you set PEER_HOST you must ALSO add it to `connect-src` in vercel.json,
# e.g.  https://your-peer.onrender.com wss://your-peer.onrender.com
PEER_HOST=
PEER_PORT=443
PEER_PATH=/ryzebooth
PEER_SECURE=true
# Same value on the peer server itself. Not a secret (browsers need it), just a namespace.
PEER_KEY=peerjs


# ── Video relay (TURN) — pick ONE provider ──────────────────────
# Without one the booth falls back to a free public relay that can be slow or
# down; a real provider is what fixes black screens between phones on mobile data.
# Tried in this order (api/ice.js).

# Cloudflare Calls TURN
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Metered  (METERED_APP = the part before .metered.live)
METERED_APP=
METERED_API_KEY=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Optional: replace the built-in last-resort relay (comma separated turn:/turns: URLs)
FALLBACK_TURN_URLS=
FALLBACK_TURN_USERNAME=
FALLBACK_TURN_CREDENTIAL=


# ── Optional ────────────────────────────────────────────────────

# Extra site URLs allowed to call the database endpoints (comma separated), e.g. a
# custom domain. Your own *.vercel.app host is always allowed.
# ALSO required by peer-server/server.js: set it on THAT host to your booth URL.
ALLOWED_ORIGIN=


# ── Only on the peer-server host (Render / Railway / Fly / VPS) ─
# ALLOWED_ORIGIN=https://your-booth.vercel.app
# PEER_KEY=peerjs
# PORT is set by the host.
